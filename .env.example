# opus-tplink-mcp configuration.
#
# Copy this file to ~/.config/opus-tplink-mcp/.env (or point TPLINK_ENV_FILE at it from your MCP client)
# and fill in the lines you need. Values set in the MCP client's own "env" block take precedence.
# Never commit your filled-in copy.

# ---------------------------------------------------------------------------- the router
# Address of the router's web page (use https://... if it redirects there).
TPLINK_HOST=192.168.0.1

# The admin password, read from a file (recommended: chmod 600, nothing else in it) ...
TPLINK_PASSWORD_FILE=~/.config/opus-tplink-mcp/router.pw
# ... or written here directly (then keep this file chmod 600).
# TPLINK_PASSWORD=your_password_here

# plain (BE9300-style firmware, default) | encrypted (e.g. BE4800 1.0.x, BE3600) |
# extender (RE X-series) | encrypted-v2 (e.g. RE3200BE fw 1.5)
# TPLINK_PROTOCOL=plain

# ---------------------------------------------------------------------------- the model driving it
# large (default): cloud / frontier models - every tool, full replies.
# small: models you run yourself (LM Studio, Ollama, ...) - the 13 everyday tools, short replies and the
#        tool's memory at the top of every reply. Tested: Gemma 4 12B / E4B, Bonsai 27B, Nemotron 3 Nano 4B
#        (see docs/local-model-bench.md). Safety is the same in both.
TPLINK_MODEL_TIER=large

# Optional overrides of what the tier sets:
# TPLINK_TOOLSET=core          # core = the 13 everyday tools; full = all of them
# TPLINK_PREVIEW=always        # always = preview every change first; critical = normal changes apply directly

# ---------------------------------------------------------------------------- more devices (optional)
# TPLINK_ROUTERS=upstairs,hallway
# TPLINK_UPSTAIRS_HOST=https://192.168.1.1
# TPLINK_UPSTAIRS_PASSWORD_FILE=~/.config/opus-tplink-mcp/upstairs.pw
# TPLINK_UPSTAIRS_PROTOCOL=encrypted
# TPLINK_HALLWAY_HOST=192.168.0.20
# TPLINK_HALLWAY_PASSWORD_FILE=~/.config/opus-tplink-mcp/extender.pw
# TPLINK_HALLWAY_PROTOCOL=extender
# TPLINK_HALLWAY_KIND=extender

# ---------------------------------------------------------------------------- optional
# TPLINK_TIMEOUT=20
# TPLINK_JOURNAL_DIR=~/.local/state/mcp-tplink-router
# TPLINK_EVENTS_FILE=~/.local/state/mcp-tplink-router/events.jsonl   # what `opus-tplink-mcp watch` / `viewer` follow
# TPLINK_REPORTING=off          # forces optional field reports OFF (only `opus-tplink-mcp setup` can turn them on)
# TPLINK_SETTLE_SECONDS=90      # wait for a device whose Wi-Fi restarts after a change (e.g. MLO)
# TPLINK_JOURNAL_KEY=~/.config/opus-tplink-mcp/journal.key   # encrypts the journal at rest (made on first use)
# TPLINK_BACKUP_DIR=~/.local/state/mcp-tplink-router/backups
# TPLINK_DEVICE_LOG_DIR=~/.local/state/mcp-tplink-router/device-logs
# TPLINK_AUTO_BACKUP=1          # download a config backup before every critical change
# TPLINK_PROTECTED_MACS=00-00-5E-00-53-01   # devices whose VPN-client routing must never break silently
# TPLINK_ALLOW_FORBIDDEN=1      # lets router_raw_write send factory-reset/firmware-class ops (still needs a token)
